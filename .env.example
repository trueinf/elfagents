# Copy to .env and fill in. .env is gitignored.

# --- LLM (one key, spend-capped — BUILD_SPEC §10, §11) ---
ANTHROPIC_API_KEY=

# claude-opus-5 at $5/$25 per million tokens. Thinking is on by default on this
# model and shares the max_tokens ceiling with the response, so the ceiling is
# set generously in code. Depth is controlled by effort, not a token budget.
ELFAGENT_MODEL=claude-opus-5
ELFAGENT_EFFORT=high

# Hard ceiling enforced in code, not in a prompt (BUILD_SPEC §10).
# The run aborts when the cap is hit; it is not advisory.
ELFAGENT_MAX_USD_PER_RUN=1.00
ELFAGENT_MAX_STEPS_PER_AGENT=8

# --- Tracing (recording + the "is this real?" proof surface — §4.1 surface 3) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elfagent-launch-readiness

# --- Local network note ---
# Avast intercepts HTTPS on this machine, so Python needs its CA bundle or
# every outbound call fails certificate verification:
#   PIP_CERT / REQUESTS_CA_BUNDLE / SSL_CERT_FILE
REQUESTS_CA_BUNDLE=C:\ProgramData\Avast Software\Avast\wscert.pem
SSL_CERT_FILE=C:\ProgramData\Avast Software\Avast\wscert.pem
